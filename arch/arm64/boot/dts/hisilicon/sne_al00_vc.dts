	peripherals {
		phandle = <0x550>;
		compatible = "simple-bus";
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges = <0x0 0x0 0x0 0xffffffff>;

		dma@fdf30000 {
			compatible = "hisilicon,hisi-dma64-1.0";
			reg = <0xfdf30000 0x1000>;
			#dma-cells = <0x1>;
			dma-channels = <0x10>;
			dma-requests = <0x20>;
			dma-min-chan = <0x1>;
			dma-used-chans = <0xfffe>;
			dma-share;
			interrupts = <0x0 0x8f 0x4>;
			clocks = <0x22c 0x1b>;
			clock-names = "clk_dmac", "apb_pclk";
			status = "ok";
			phandle = <0x5d>;
		};
	};

	cambricon-ipu@ff400000 {
		vipu-supply = <0x22d>;
		compatible = "hisilicon,cambricon-ipu";
		reg = <0x0 0xff400000 0x0 0x100000 0x0 0xff500000 0x0 0x100000>;
		interrupts = <0x0 0x15f 0x4>;
		interrupt-names = "ipu_dma_irq";
		status = "disabled";

		iommu_info {
			start-addr = <0x40000>;
			size = <0xe0000000>;
		};
	};

	target-cpu {
		compatible = "hisi,targetcpu";
