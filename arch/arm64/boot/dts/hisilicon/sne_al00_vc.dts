	sdhci@FF3E1000 {
		compatible = "mshc,sdhci";
		reg = <0x0 0xff3e6000 0x0 0x1000 0x0 0xff3e1000 0x0 0x1000 0x0 0xff3e2000 0x0 0x1000 0x0 0xff3e3000 0x0 0x1000 0x0 0xff3e4000 0x0 0x1000 0x0 0xff3e5000 0x0 0x1000>;
		clock-names = "clk_xin";
		clocks = <0x1b6>;
		interrupt-parent = <0x1>;
		interrupts = <0x0 0x117 0x4>;
		bus-width = <0x8>;
		non-removable;
		use-adma;
		sdhci-adma-64bit;
		caps2-mmc-cache-ctrl;
		caps2-mmc-HC-erase-size;
		coldboot_on_reset_fail;
		status = "ok";
		clk-xin = <0xb71b000>;
		vmmc-supply = <0x1b7>;
		keep-power-in-suspend;
		caps2-mmc-hs400-1_8v;
		caps2-mmc-bkops_auto-ctrl;
		caps2-mmc-cmd-queue;
		phandle = <0x4d2>;

		mmccard@0 {
			reg = <0x0>;
			compatible = "mmc-card";
			broken-hpi;
			phandle = <0x4d3>;
		};
	};

	dwmmc1@FF37F000 {
		compatible = "hisilicon,libra-dw-mshc";
		reg = <0x0 0xff37f000 0x0 0x1000>;
		interrupts = <0x0 0x8b 0x4>;
		num-slots = <0x1>;
		clocks = <0x1b8 0x1b9 0x1ba>;
		clock-names = "ciu", "biu", "volt_hold";
		fifo-depth = <0x100>;
		card-detect-delay = <0xc8>;
		supports-highspeed;
		pinctrl-names = "default", "idle";
		pinctrl-0 = <0x1bb 0x1bc 0x1bd 0x1be 0x1bf 0x1c0 0x1c1 0x1c2 0x1c3 0x1c4 0x1c5 0x1c6>;
		pinctrl-1 = <0x1c7 0x1c8 0x1c9 0x1ca 0x1cb 0x1cc 0x1cd 0x1ce 0x1cf 0x1d0 0x1d1 0x1d2>;
		vmmc-supply = <0x1d3>;
		vqmmc-supply = <0xdf>;
		use_samdly_range = <0xc 0x10>;
		enable_shift_range = <0x4 0xc>;
