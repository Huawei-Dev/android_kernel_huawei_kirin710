	firmware {
		phandle = <0x4c2>;

		android {
			compatible = "android,firmware";
			boot_devices = "ff3c0000.ufs,hi_mci.0";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,kernel,ramdisk,eng_system,eng_vendor,vbmeta_system,vbmeta_vendor,vbmeta_odm,vbmeta_hw_product,vbmeta_cust,version,preload,modem_driver,preas,preavs";
				ta_parts = "kernel,ramdisk,vbmeta_system,vbmeta_vendor,vbmeta_odm,vbmeta_hw_product,preas,preavs,vbmeta_cust";
			};

			fstab {
				compatible = "android,fstab";

				system_ext4 {
					mnt_point = "/system";
					dev = "system";
					type = "ext4";
					mnt_flags = "ro";
					fsmgr_flags = "wait,avb,logical";
					status = "ok";
				};

				system_erofs {
					mnt_point = "/system";
					dev = "system";
					type = "erofs";
