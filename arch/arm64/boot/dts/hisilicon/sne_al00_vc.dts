				pmu_status1_address = <0x7>;
				pmu_ldo11_onoff_eco_address = <0x19>;
				pmu_ldo11_vset_address = <0x52>;
				pmu_ldo12_onoff_eco_address = <0x1a>;
				pmu_ldo12_vset_address = <0x53>;
				pmu_sim_ctrl_address = <0x153>;
				pmu_sim_deb_ctrl_address = <0x155>;
				pmu_irq_mask3_address = <0x18d>;
				pmu_irq3_address = <0x19c>;
				pmu_irq_mask_address = <0x18d>;
				pmu_irq_address = <0x19c>;
				pmu_ldo11_onoff_value = <0x3>;
				pmu_ldo11_vset_value = <0x1>;
				pmu_ldo12_onoff_value = <0x3>;
				pmu_ldo12_vset_value = <0x1>;
