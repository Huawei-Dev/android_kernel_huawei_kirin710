/dts-v1/;

/ {
	hisi,boardname = "SNE_AL00_VC";
	hisi,product_name = "SNE-AL00";
	hisi,modem_id = "8bH";
	hisi,boardid = <0x7 0x9 0x6 0x3>;
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	model = "kirin710";
	compatible = "hisilicon,kirin710";
	interrupt-parent = <0x1>;
	hisi,chipid = <0x2 0x6 0x0 0x1>;

	fastboot_core {
		compatible = "fastboot,coul";
		coul_type = <0x6>;
		status = "ok";
		phandle = <0x231>;
	};

	slimbusmisc@0xe8050000 {
		compatible = "candance,slimbus";
		reg = <0x0 0xe8050000 0x0 0xb00 0x0 0xe804e000 0x0 0xa000 0x0 0xfff0a000 0x0 0x1000>;
		slimbus-reg-supply = <0x2>;
		status = "disabled";
		phandle = <0x232>;
	};

	codecssi@0xe82b9000 {
		compatible = "hisilicon,codecssi";
		reg = <0x0 0xe82b9000 0x0 0x800>;
		status = "disabled";
		phandle = <0x233>;
	};

	ddr_devfreq@fffc0000 {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		compatible = "hisilicon,ddr_devfreq";
		reg = <0x0 0xfffc0000 0x0 0x10000>;
		pm_qos_data_reg = <0x8 0x3c>;
		clocks = <0x3 0x4>;
		pm_qos_class = "memory_tput";
		operating-points = <0x318f8 0x0 0x6e1b8 0x0 0xdc370 0x0 0x12ff48 0x0 0x18bff0 0x0>;
		vote_method = "hardware";
		status = "ok";
	};

	panel_lcd_lg_S6E3HF4_5P5 {
	};

	panel_lcd_samsung_S6E3HF4_5P5 {
	};

	panel_lcd_lg_TD4322_6P0 {
	};

	panel_lcd_sharp_TD4322_6P0 {
