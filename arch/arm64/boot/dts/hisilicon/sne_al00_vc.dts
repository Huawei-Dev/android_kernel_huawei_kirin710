					type = "erofs";
					mnt_flags = "ro";
					fsmgr_flags = "wait,avb,logical";
					status = "ok";
				};

				odm_ext4 {
					mnt_point = "/odm";
					dev = "odm";
					type = "ext4";
					mnt_flags = "ro";
					fsmgr_flags = "wait,avb,logical";
					status = "ok";
				};

				odm_erofs {
					mnt_point = "/odm";
					dev = "odm";
					type = "erofs";
					mnt_flags = "ro";
					fsmgr_flags = "wait,avb,logical";
					status = "ok";
				};

				cust_ext4 {
					mnt_point = "/cust";
					dev = "cust";
					type = "ext4";
					mnt_flags = "ro";
					fsmgr_flags = "wait,nofail,avb,logical";
					status = "ok";
				};

				cust_erofs {
					mnt_point = "/cust";
					dev = "cust";
					type = "erofs";
					mnt_flags = "ro";
					fsmgr_flags = "wait,nofail,avb,logical";
					status = "ok";
				};

				hw_product_ext4 {
					mnt_point = "/hw_product";
					dev = "hw_product";
					type = "ext4";
