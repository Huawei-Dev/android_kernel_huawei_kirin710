				interrupt-parent = <0x1b5>;
				interrupts = <0x3 0x0>;
				interrupt-names = "hisi-pmic-rtc";
				hisilicon,pmic-rtc-base = <0x340>;
				hisilicon,pmic-rtc-imr = <0x18c>;
				hisilicon,pmic-rtc-icr = <0x19b>;
