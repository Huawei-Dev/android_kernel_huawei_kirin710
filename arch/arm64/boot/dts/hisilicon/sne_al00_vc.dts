				det_normal_direction = "closed";
				allocate_gpio = <0x0>;
				shared_det_irq = <0x1>;
				send_msg_to_cp = <0x1>;
				card_tray_style = <0x1>;
				hpd_interrupt_to_close_ldo = <0xa>;
				hpd_debounce_wait_time = <0x0>;
				det_debounce_wait_time = <0x12c>;
