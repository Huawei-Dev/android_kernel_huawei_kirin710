		serial2 = "/amba/uart@fdf03000";
		serial3 = "/amba/uart@ffd74000";
		serial4 = "/amba/uart@fdf01000";
		serial5 = "/amba/uart@fdf05000";
		serial6 = "/amba/uart@fff32000";
