	ddr_devfreq_latency@fffc0000 {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		compatible = "hisilicon,ddr_devfreq_latency";
		reg = <0x0 0xfffc0000 0x0 0x10000>;
		pm_qos_data_reg = <0x8 0x3c>;
		clocks = <0x3 0x4>;
