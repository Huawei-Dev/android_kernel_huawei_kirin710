			};
			fstab {
				compatible = "android,fstab";
				system_ext4 {
					mnt_point = "/system";
					dev = "system";
					type = "ext4";
					mnt_flags = "ro";
					fsmgr_flags = "wait,avb,logical";
					status = "ok";
				};
				system_erofs {
					mnt_point = "/system";
