	firmware {
		phandle = <0x4c8>;
		android {
			compatible = "android,firmware";
			boot_devices = "ff3c0000.ufs,hi_mci.0";
			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,kernel,ramdisk,eng_system,eng_vendor,vbmeta_system,vbmeta_vendor,vbmeta_odm,vbmeta_hw_product,vbmeta_cust,version,preload,modem_driver,preas,preavs";
